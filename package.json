{
  "name": "wit",
  "version": "0.3.0",
  "private": true,
  "description": "Wit for Claude Code: self-tuning token optimization (Python hooks) and Morpheus, a live local dashboard of hooks, skills, agents and tokens (Node).",
  "license": "MIT",
  "type": "module",
  "bin": { "morpheus": "plugins/wit/morpheus/dist/cli.js" },
  "files": [
    "plugins/wit/morpheus/dist",
    "plugins/wit/morpheus/web",
    "plugins/wit/morpheus/hooks",
    "README.md",
    "LICENSE"
  ],
  "engines": { "node": ">=23.6" },
  "scripts": {
    "start": "node plugins/wit/morpheus/src/cli.ts serve --open",
    "pretest": "node -e \"require('node:fs').mkdirSync('coverage', { recursive: true })\"",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=99 --test-coverage-branches=99 --test-coverage-functions=99 --test-coverage-include='plugins/wit/morpheus/src/**' --test-coverage-include='plugins/wit/morpheus/web/src/**' --test-coverage-include='plugins/wit/morpheus/scripts/inline.ts' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=junit --test-reporter-destination=coverage/junit.xml plugins/wit/morpheus/test/*.test.ts",
    "test:fast": "node --test plugins/wit/morpheus/test/*.test.ts",
    "build": "node --no-warnings plugins/wit/morpheus/scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code plugins/wit/morpheus/dist plugins/wit/morpheus/web/dashboard.html"
  },
  "repository": { "type": "git", "url": "https://github.com/niiashikwei/wit.git" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0" }
}
